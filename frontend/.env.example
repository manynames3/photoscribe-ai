# Leave VITE_API_URL blank for local preview mode with bundled sample results.
# Set it to the API Gateway base URL after deploying the AWS backend.
VITE_API_URL=

# Required only when staff sign-in is enabled.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Optional. When blank, "Request pilot access" links to the landing-page pilot section.
VITE_CONTACT_EMAIL=
