extra_frontend_origins = [
  "https://your-project.pages.dev",
  "https://photos.example.com",
]

enable_aws_frontend_hosting = false

# Keep true for private-library behavior. The frontend can still run in local
# preview mode with VITE_API_URL blank when you do not want to call AWS.
enable_api_auth = true

# New uploads should enter review before broad staff use.
default_asset_review_status = "pending_review"

# Optional break-glass owner upload token. Cognito staff auth is preferred.
# Store only the SHA-256 hash here.
upload_token_sha256 = ""

# Optional. CloudWatch dashboards can add a small monthly AWS charge.
enable_operational_dashboard = false
